{
  "ruleset_id": "beauty_accessories_lead_capture_incentives",
  "store_id": "beauty_accessories",
  "purpose": "Capture leads ethically, deliver useful incentives, and protect margin before offers go live.",
  "definitions": {
    "lead": "A person who has shown interest but has not bought yet.",
    "lead_magnet": "A useful free asset offered in exchange for a sign-up.",
    "incentive": "A reason to take action, such as a discount, PDF, free shipping threshold, or early access."
  },
  "required_form_fields": [
    "email",
    "country",
    "main_interest",
    "marketing_consent",
    "lead_magnet_requested",
    "source_campaign"
  ],
  "optional_form_fields_later": [
    "birthday_month",
    "routine_type",
    "hair_interest",
    "travel_frequency",
    "preferred_product_category"
  ],
